PORT=5000
MONGODB_URI=mongodb://<usuario>:<senha>@localhost:27017/ecommerce?authSource=admin
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
PASSWORD_RESET_MINUTES=60
ALLOW_RESET_TOKEN_RESPONSE=true
CORS_ORIGIN=http://localhost:5500
ADMIN_EMAIL=admin@techstore.com.br
ADMIN_PASSWORD=troque-esta-senha
# --- Integracoes (segredos: SOMENTE .env, nunca via API; dashboard não tem campos p/ MP) ---
# Mercado Pago: token direto OU OAuth (docs/Create and refresh token.md)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# OAuth MP (conecta a conta do lojista sem colar token): crie o app em
# https://www.mercadopago.com.br/developers/panel/app e preencha:
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
# PagSeguro (PagBank Orders API): https://developer.pagbank.com.br/reference/introducao
# Producao: https://api.pagseguro.com | Sandbox/teste: https://sandbox.api.pagseguro.com
# Token Connect (5 blocos). Sandbox e producao usam tokens distintos.
PGS_EMAIL=
PGS_TOKEN=
PGS_WEBHOOK_TOKEN=
PGS_SANDBOX=true
# URL publica https do backend (exigida p/ notification_urls do webhook; localhost e rejeitado)
API_PUBLIC_URL=
# E-mail de venda: SMTP tradicional OU Gmail API (guia em docs/EMAIL.md)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=
# Fotos de produtos (upload do dashboard; volume fotos_data no compose)
FOTOS_DIR=/app/fotos
EVO_API_URL=http://evolution:8080
EVO_APIKEY=troque-esta-chave
FRONT_URL=http://localhost:8083
SETTINGS_KEY=troque-por-64-hex-gerados-com-openssl-rand-hex-32
E2E_NO_LIMIT=
